{
  "entities": {
    "submission": {
      "title": "Submission",
      "description": "Internal HO Nusantara Mineral Payment voucher submission metadata and line items status tracker.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lokasi": { "type": "string" },
        "tanggal": { "type": "string", "format": "date" },
        "jenisPengajuan": { "type": "string" },
        "kode": { "type": "string" },
        "dibayarkanKepada": { "type": "string" },
        "dibayarkanDengan": { "type": "string", "enum": ["Tunai", "Cek/Transfer"] },
        "notes": { "type": "string" },
        "dibuatOleh": { "type": "string" },
        "disetujuiOleh": { "type": "string" },
        "diverifikasiOleh": { "type": "string" },
        "diverifikasiJabatan": { "type": "string" },
        "disetujuiOleh2": { "type": "string" },
        "disetujuiJabatan2": { "type": "string" },
        "dibukukanOleh": { "type": "string" },
        "dibukukanJabatan": { "type": "string" },
        "items": { "type": "array", "description": "Submission items list" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "lokasi", "tanggal", "dibayarkanKepada", "items"]
    },
    "npwpRecord": {
      "title": "NpwpRecord",
      "description": "Master list of company and vendor tax records (NPWP).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "companyName": { "type": "string" },
        "npwpNumber": { "type": "string" },
        "address": { "type": "string" },
        "kppName": { "type": "string" },
        "taxStatus": { "type": "string", "enum": ["PKP", "Non-PKP"] },
        "contactPerson": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "companyName", "npwpNumber"]
    },
    "attendanceRecord": {
      "title": "AttendanceRecord",
      "description": "Attendance tracking records for workers.",
      "type": "object",
      "properties": {
        "workerId": { "type": "string" },
        "attendance": { "type": "object" },
        "customStatus": { "type": "object" },
        "reasons": { "type": "object" }
      },
      "required": ["workerId"]
    },
    "worker": {
      "title": "Worker",
      "description": "Master employee / field worker profile stored in Firestore.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "isActive": { "type": "boolean" },
        "phoneNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAccount": { "type": "string" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "monthlyTransaction": {
      "title": "MonthlyRecurringTransaction",
      "description": "Recurring monthly transaction schedule detected automatically every month before due day 15.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "recipient": { "type": "string" },
        "defaultAmount": { "type": "number" },
        "paymentMethod": { "type": "string", "enum": ["Tunai", "Cek/Transfer"] },
        "dueDay": { "type": "number" },
        "isActive": { "type": "boolean" },
        "startMonth": { "type": "string" },
        "companyId": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "title", "category", "recipient", "dueDay", "isActive"]
    },
    "internalMemo": {
      "title": "InternalMemo",
      "description": "Official PT NMSA internal memo document metadata and Google Drive archive link.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorMemo": { "type": "string" },
        "tanggal": { "type": "string" },
        "dari": { "type": "string" },
        "kepada": { "type": "string" },
        "perihal": { "type": "string" },
        "isiSurat": { "type": "string" },
        "driveUrl": { "type": "string" },
        "driveFileId": { "type": "string" },
        "driveFolderPath": { "type": "string" },
        "signedDriveUrl": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nomorMemo", "tanggal", "perihal"]
    },
    "employeeLoan": {
      "title": "EmployeeLoan",
      "description": "Employee loan application, installment ledger, and Google Drive archive link.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "nomorPinjaman": { "type": "string" },
        "tanggalPermohonan": { "type": "string" },
        "namaKaryawan": { "type": "string" },
        "jumlahPinjaman": { "type": "number" },
        "status": { "type": "string" },
        "payments": { "type": "array" },
        "driveUrl": { "type": "string" },
        "driveFileId": { "type": "string" },
        "driveFolderPath": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "nomorPinjaman", "namaKaryawan", "jumlahPinjaman", "status"]
    }
  },
  "firestore": {
    "submissions": {
      "schema": "submission",
      "description": "Global user-submitted invoices ledger and cash book entries."
    },
    "npwp_records": {
      "schema": "npwpRecord",
      "description": "Master list of registered taxpayer companies and vendors."
    },
    "workers": {
      "schema": "worker",
      "description": "Individual employee documents (when enabled in rules)."
    },
    "attendance": {
      "schema": "attendanceRecord",
      "description": "Daily employee attendance, weekly meal allowance reports, workers_master, internal_memos_master, employee_loans_master, and monthly_transactions_master."
    },
    "internal_memos": {
      "schema": "internalMemo",
      "description": "Official Internal Memo Direksi synced across PC and mobile devices."
    },
    "employee_loans": {
      "schema": "employeeLoan",
      "description": "Employee loans and installment payment records synced across devices."
    }
  }
}

