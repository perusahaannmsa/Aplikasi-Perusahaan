rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // KOLEKSI AKTIF APLIKASI (WAJIB LOGIN FIREBASE AUTH)
    // Mengizinkan baca & tulis bagi pengguna yang sudah login di aplikasi,
    // termasuk saat upload data dari penyimpanan sementara/lokal ke Firestore.
    // =========================================================================

    // 1. Transaksi Voucher & Pengajuan Dana HO / Kas / Bank
    match /submissions/{submissionId} {
      allow list: if isSignedIn();
      allow get, delete: if isSignedIn() && isValidId(submissionId);
      allow create, update: if isSignedIn() && isValidId(submissionId) && request.resource.data is map;
    }

    // 2. Master Data NPWP Rekanan & Perusahaan
    match /npwp_records/{recordId} {
      allow list: if isSignedIn();
      allow get, delete: if isSignedIn() && isValidId(recordId);
      allow create, update: if isSignedIn() && isValidId(recordId) && request.resource.data is map;
    }

    // 3. Master List Data Karyawan
    match /workers/{workerId} {
      allow list: if isSignedIn();
      allow get, delete: if isSignedIn() && isValidId(workerId);
      allow create, update: if isSignedIn() && isValidId(workerId) && request.resource.data is map;
    }

    // 4. Data Absensi Harian Terpusat & Dokumen Master Sinkronisasi
    // (current_records, workers_master, internal_memos_master,
    //  employee_loans_master, monthly_transactions_master, & rep_*)
    match /attendance/{attendanceId} {
      allow list: if isSignedIn();
      allow get, delete: if isSignedIn() && isValidId(attendanceId);
      allow create, update: if isSignedIn() && isValidId(attendanceId) && request.resource.data is map;
    }

    // 5. Internal Memo Direksi (sinkron antar PC & HP)
    match /internal_memos/{memoId} {
      allow list: if isSignedIn();
      allow get, delete: if isSignedIn() && isValidId(memoId);
      allow create, update: if isSignedIn() && isValidId(memoId) && request.resource.data is map;
    }

    // 6. Pinjaman Karyawan & Riwayat Cicilan (sinkron antar PC & HP)
    match /employee_loans/{loanId} {
      allow list: if isSignedIn();
      allow get, delete: if isSignedIn() && isValidId(loanId);
      allow create, update: if isSignedIn() && isValidId(loanId) && request.resource.data is map;
    }

    // 7. Profil Perusahaan & Pengaturan Multi-PT
    match /companies/{companyId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(companyId) && request.resource.data is map;
      allow delete: if false;
    }

    // 8. Profil Pengguna (hanya dapat diakses oleh pemilik UID masing-masing)
    match /users/{uid} {
      allow get, create, update: if isSignedIn() && request.auth.uid == uid;
      allow list, delete: if false;
    }

    // =========================================================================
    // KOLEKSI OBSOLETE / PEMBERSIHAN (Hanya Baca & Hapus oleh User Login)
    // =========================================================================
    match /absen_records/{recordId} {
      allow read, delete: if isSignedIn();
      allow write: if false;
    }

    match /activity_logs/{logId} {
      allow read, delete: if isSignedIn();
      allow write: if false;
    }

    match /sppd_records/{recordId} {
      allow read, delete: if isSignedIn();
      allow write: if false;
    }

    match /accurate_mappings/{recordId} {
      allow read, delete: if isSignedIn();
      allow write: if false;
    }

    match /office_config/{configId} {
      allow read, delete: if isSignedIn();
      allow write: if false;
    }

    match /test/{docId} {
      allow read, delete: if isSignedIn();
      allow write: if false;
    }
  }
}
