rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Global Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    // 1. Companies (Voucher / Invoice App Company Config & Shared Drive Settings)
    match /companies/{companyId} {
      allow read, write: if true;
    }

    // 2. Submissions (Voucher / Invoice App Transactions)
    match /submissions/{submissionId} {
      allow read, write: if true;
    }

    // 3. Activity Logs (Audit Trail & Activity Logs)
    match /activity_logs/{logId} {
      allow read, write: if true;
    }

    // 4. NPWP Master Records
    match /npwp_records/{recordId} {
      allow read, write: if true;
    }

    // 5. SPPD (Surat Perintah Perjalanan Dinas) Records
    match /sppd_records/{recordId} {
      allow read, write: if true;
    }

    // 6. Accurate & SPPD Account Mappings
    match /accurate_mappings/{recordId} {
      allow read, write: if true;
    }

    // 7. Absen Records
    match /absen_records/{recordId} {
      allow read, write: if true;
    }

    // 8. Connected Drives Collection
    match /connected_drives/{driveId} {
      allow read, write: if true;
    }

    // 9. Users Collection
    match /users/{uid} {
      allow read, write: if true;
    }

    // 10. Office Config & Attendance
    match /office_config/{configId} {
      allow read, write: if true;
    }

    match /attendance/{attendanceId} {
      allow read, write: if true;
    }

    // 11. Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}

